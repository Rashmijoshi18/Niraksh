# Backend API URL (without trailing slash or /api)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google OAuth Client ID (optional for Google Login)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# CountryStateCity API Key (optional, for state and city dropdowns)
NEXT_PUBLIC_CSC_API_KEY=your_csc_api_key

# Canonical site URL (optional, for metadata and SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
